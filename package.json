{
  "name": "@xunjie/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.21.0" },
  "workspaces": ["apps/*", "packages/*", "tools/xj-dev", "tools/xj-dev-access"],
  "scripts": {
    "preinstall": "node apps/server/tools/check-runtime.mjs",
    "build": "npm run build -w @xunjie/contracts && npm run build -w @xunjie/server && npm run build -w @xunjie/web",
    "typecheck": "npm run build -w @xunjie/contracts && npm run typecheck --workspaces --if-present",
    "test": "npm run test:checks && npm run build -w @xunjie/contracts && npm run test -w packages -w apps --if-present && node scripts/test.mjs tools",
    "test:checks": "node scripts/test.mjs checks",
    "check:contracts:browser": "npm run check:browser -w @xunjie/contracts",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test:external": "node scripts/test.mjs server --external",
    "test:external:tools": "node scripts/test.mjs tools --external",
    "test:tools": "node scripts/test.mjs tools",
    "test:e2e": "npm run test:e2e -w @xunjie/web",
    "verify": "node apps/server/tools/check-runtime.mjs && node scripts/verify.mjs"
  },
  "devDependencies": {
    "entities": "9.0.0",
    "esbuild": "0.28.2",
    "marked": "18.1.0"
  }
}
