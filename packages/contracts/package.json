{
  "name": "@xunjie/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-safe shared XunJie wire contracts and codecs",
  "files": [
    "dist"
  ],
  "exports": {
    "./teaching-artifacts-reference": { "types": "./dist/teaching-artifacts-reference.d.ts", "import": "./dist/teaching-artifacts-reference.js" },
    "./teaching-artifacts": { "types": "./dist/teaching-artifacts.d.ts", "import": "./dist/teaching-artifacts.js" },
    "./agent-skills": { "types": "./dist/agent-skills.d.ts", "import": "./dist/agent-skills.js" },
    "./pdf-materials": { "types": "./dist/pdf-materials.d.ts", "import": "./dist/pdf-materials.js" },
    "./personal-materials": { "types": "./dist/personal-materials.d.ts", "import": "./dist/personal-materials.js" },
    "./alu-learning": { "types": "./dist/alu-learning.d.ts", "import": "./dist/alu-learning.js" },
    "./alu-references": { "types": "./dist/alu-references.d.ts", "import": "./dist/alu-references.js" },
    "./alu-waveform": { "types": "./dist/alu-waveform.d.ts", "import": "./dist/alu-waveform.js" },
    "./components": { "types": "./dist/components.d.ts", "import": "./dist/components.js" },
    "./model-connections": { "types": "./dist/model-connections.d.ts", "import": "./dist/model-connections.js" },
    "./action-intents": { "types": "./dist/action-intents.d.ts", "import": "./dist/action-intents.js" },
    "./execution": { "types": "./dist/execution.d.ts", "import": "./dist/execution.js" },
    "./spaces": { "types": "./dist/spaces.d.ts", "import": "./dist/spaces.js" },
    "./courses": { "types": "./dist/courses.d.ts", "import": "./dist/courses.js" },
    "./learning-data": { "types": "./dist/learning-data.d.ts", "import": "./dist/learning-data.js" },
    "./question-drafts": { "types": "./dist/question-drafts.d.ts", "import": "./dist/question-drafts.js" },
    "./teaching-agent": { "types": "./dist/teaching-agent.d.ts", "import": "./dist/teaching-agent.js" },
    "./student-facts": { "types": "./dist/student-facts.d.ts", "import": "./dist/student-facts.js" },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./editor-diagnostics": {
      "types": "./dist/editor-diagnostics.d.ts",
      "import": "./dist/editor-diagnostics.js"
    },
    "./product-runtime": {
      "types": "./dist/product-runtime.d.ts",
      "import": "./dist/product-runtime.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "scripts": {
    "pretest": "node ../../scripts/build.mjs contracts:test",
    "build": "node ../../scripts/build.mjs contracts --",
    "typecheck": "node ../../scripts/build.mjs contracts:typecheck",
    "check:browser": "node ../../scripts/check-contracts-browser.mjs",
    "test": "node ../../scripts/test.mjs contracts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
