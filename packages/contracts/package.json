{
  "name": "@xunjie/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-safe shared XunJie wire contracts and codecs",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./editor-diagnostics": {
      "types": "./dist/editor-diagnostics.d.ts",
      "import": "./dist/editor-diagnostics.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/test.mjs contracts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
