{
  "name": "@xunjie/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-safe shared XunJie wire contracts and codecs",
  "files": [
    "dist"
  ],
  "exports": {
    "./action-intents": { "types": "./dist/action-intents.d.ts", "import": "./dist/action-intents.js" },
    "./spaces": { "types": "./dist/spaces.d.ts", "import": "./dist/spaces.js" },
    "./courses": { "types": "./dist/courses.d.ts", "import": "./dist/courses.js" },
    "./learning-data": { "types": "./dist/learning-data.d.ts", "import": "./dist/learning-data.js" },
    "./question-drafts": { "types": "./dist/question-drafts.d.ts", "import": "./dist/question-drafts.js" },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./editor-diagnostics": {
      "types": "./dist/editor-diagnostics.d.ts",
      "import": "./dist/editor-diagnostics.js"
    },
    "./product-runtime": {
      "types": "./dist/product-runtime.d.ts",
      "import": "./dist/product-runtime.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "scripts": {
    "pretest": "node ../../scripts/build.mjs contracts:test",
    "build": "node ../../scripts/build.mjs contracts --",
    "typecheck": "node ../../scripts/build.mjs contracts:typecheck",
    "check:browser": "node ../../scripts/check-contracts-browser.mjs",
    "test": "node ../../scripts/test.mjs contracts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
