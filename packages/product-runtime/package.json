    "./learning-http/agent-http": {
      "types": "./dist/learning-http/agent-http.d.ts",
      "import": "./dist/learning-http/agent-http.js"
    },
    "./learning-http/execution-http": {
      "types": "./dist/learning-http/execution-http.d.ts",
