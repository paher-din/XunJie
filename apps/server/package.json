{
  "name": "@xunjie/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { "./learning-entry": { "types": "./dist/server/learning-entry/index.d.ts", "import": "./dist/server/learning-entry/index.js" } },
  "description": "XunJie composable backend and existing course runner",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "preinstall": "node tools/check-runtime.mjs",
    "typecheck": "node tools/check-runtime.mjs && tsc --noEmit",
    "build": "node tools/check-runtime.mjs && node ../../scripts/build-server.mjs",
    "pretest": "npm run build",
    "test": "node tools/check-runtime.mjs && node ../../scripts/test.mjs server",
    "test:external": "node ../../scripts/test.mjs server --external",
    "start": "node tools/check-runtime.mjs && node dist/server/main.js"
  },
  "dependencies": {
    "@xunjie/contracts": "0.1.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/session": "11.1.4",
    "@ai-sdk/deepseek": "3.0.63",
    "ai": "7.0.136",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "zod": "4.6.5",
    "@xunjie/storage": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
