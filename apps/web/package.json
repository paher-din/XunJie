{
  "name": "@xunjie/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "循阶师生共用 Web 应用",
  "scripts": {
    "dev": "vite",
    "dev:prep": "vite --mode prep --port 5601 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "playwright test",
    "predev": "npm run build -w @xunjie/contracts",
    "predev:prep": "npm run build -w @xunjie/contracts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@tanstack/react-query": "^5.66.0",
    "marked": "^18.1.0",
    "monaco-editor": "0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "remend": "^1.4.0",
    "@xunjie/contracts": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
