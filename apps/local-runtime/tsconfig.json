{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true, "declaration": true,
    "rootDir": "src", "outDir": "dist", "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
