#include <tunables/global>
profile xunjie-dlc-v1 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  file,
  network,
  capability,
  signal,
  umount,
  deny mount,
  deny /proc/** rwklx,
  deny /sys/** rwklx,
  deny /dev/fd/** rwklx,
  deny /dev/stdin rw,
  deny /dev/stdout rw,
  deny /dev/stderr rw,
  deny network raw,
  deny network packet,
}
