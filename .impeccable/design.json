  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "旧版学生界面的主要操作。",
      "html": "<button class=\"ds-button-primary\" type=\"button\">进入任务</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 16px;border-radius:8px;font:500 13px/1.5 var(--font-sans,-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif);white-space:nowrap;cursor:pointer;border:0;background:var(--primary,#1f2328);color:var(--on-primary,#fff)}.ds-button-primary:hover{filter:brightness(.96)}.ds-button-primary:focus-visible{outline:3px solid var(--focus-ring,#7ab3ff);outline-offset:3px}"
    },
    {
      "name": "次级按钮",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "与主按钮共用尺寸，使用描边区分次级操作。",
      "html": "<button class=\"ds-button-outline\" type=\"button\">刷新列表</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 16px;border-radius:8px;font:500 13px/1.5 var(--font-sans,-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif);white-space:nowrap;cursor:pointer;border:1px solid var(--line-strong,#e0e0de);background:var(--raised,#fff);color:var(--ink-soft,#42474d)}.ds-button-outline:hover{filter:brightness(.96)}.ds-button-outline:focus-visible{outline:3px solid var(--focus-ring,#7ab3ff);outline-offset:3px}"
    },
    {
      "name": "文字输入框",
      "kind": "input",
      "refersTo": "input-field",
      "description": "设置页字段：聚焦时使用强调色边界和柔光。",
      "html": "<input class=\"ds-input\" aria-label=\"名称\" placeholder=\"请输入名称\">",
      "css": ".ds-input{box-sizing:border-box;width:220px;height:36px;border:1px solid var(--line-strong,#e0e0de);border-radius:8px;padding:0 12px;font:13px/1.5 var(--font-sans,-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif);color:var(--ink,#1f2328);background:var(--raised,#fff);transition:border-color .15s cubic-bezier(.3,1,.35,1),box-shadow .15s cubic-bezier(.3,1,.35,1)}.ds-input::placeholder{color:var(--faint,#9ca0a6)}.ds-input:focus{outline:none;border-color:var(--accent,#007aff);box-shadow:var(--focus-glow,0 0 0 3px rgba(0,122,255,.14))}"
    },
    {
      "name": "侧栏导航",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "中性侧栏中的当前入口；悬停与选中由底色和文字共同表达。Solar 图标来源与许可见 DESIGN.md 的 Usage Rights。",
      "html": "<nav aria-label=\"主导航\"><button class=\"ds-nav-item ds-nav-active\" type=\"button\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M2.5192 7.82274C2 8.77128 2 9.91549 2 12.2039V13.725C2 17.6258 2 19.5763 3.17157 20.7881C4.34315 22 6.22876 22 10 22H14C17.7712 22 19.6569 22 20.8284 20.7881C22 19.5763 22 17.6258 22 13.725V12.2039C22 9.91549 22 8.77128 21.4808 7.82274C20.9616 6.87421 20.0131 6.28551 18.116 5.10812L16.116 3.86687C14.1106 2.62229 13.1079 2 12 2C10.8921 2 9.88939 2.62229 7.88403 3.86687L5.88403 5.10813C3.98695 6.28551 3.0384 6.87421 2.5192 7.82274ZM11.25 18C11.25 18.4142 11.5858 18.75 12 18.75C12.4142 18.75 12.75 18.4142 12.75 18V15C12.75 14.5858 12.4142 14.25 12 14.25C11.5858 14.25 11.25 14.5858 11.25 15V18Z\" clip-rule=\"evenodd\"/></svg><span>首页</span></button></nav>",
      "css": ".ds-nav-item{display:flex;align-items:center;gap:12px;text-align:left;padding:8px 12px;border:0;border-radius:8px;font:13px/1.5 var(--font-sans,-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif);color:var(--muted,#656d76);background:transparent;cursor:pointer;transition:background-color .15s cubic-bezier(.3,1,.35,1),color .15s cubic-bezier(.3,1,.35,1)}.ds-nav-item svg{width:18px;height:18px;flex:none}.ds-nav-item:hover{background:var(--chip-bg,#f1f1ef);color:var(--ink,#1f2328)}.ds-nav-item:active{background:var(--line,#e8e8e6)}.ds-nav-active,.ds-nav-active:hover{background:var(--chip-active,#e5e5e9);color:var(--ink,#1f2328);font-weight:600}.ds-nav-item:focus-visible{outline:3px solid var(--focus-ring,#7ab3ff);outline-offset:3px}"
    },
    {
      "name": "状态标记",
      "kind": "chip",
      "refersTo": "status-badge-progress",
      "description": "状态以浅底深字配合文字呈现。",
      "html": "<span class=\"ds-status\">进行中</span>",
      "css": ".ds-status{display:inline-block;white-space:nowrap;background:var(--status-progress-bg,#cffafe);color:var(--status-progress-fg,#155e75);padding:4px 8px;border-radius:6px;font:11px/1.5 var(--font-sans,-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif)}"
    },
    {
      "name": "项目任务卡",
      "kind": "card",
      "refersTo": "task-card",
      "description": "旧版任务卡以细描边、微阴影和标题、目标、操作组成；操作小字的对比度仍需修复。",
      "html": "<button class=\"ds-task\" type=\"button\"><span class=\"ds-task-title\">项目任务</span><span class=\"ds-task-goal\">阅读目标并开始探索。</span><span class=\"ds-task-action\">进入任务 →</span></button>",
      "css": ".ds-task{box-sizing:border-box;width:280px;min-height:195px;display:flex;flex-direction:column;text-align:left;border:1px solid var(--line,#e8e8e6);border-radius:8px;padding:20px;background:transparent;box-shadow:var(--panel-shadow,0 1px 2px rgba(24,34,57,.05));cursor:pointer}.ds-task-title{font:600 15px/1.5 'LXGW WenKai','Kaiti SC',STKaiti,serif;color:var(--ink,#1f2328);margin:12px 0 8px}.ds-task-goal{font:13px/1.7 var(--font-sans,-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif);color:var(--muted,#656d76);margin-bottom:16px}.ds-task-action{margin-top:auto;font:12px/1.5 var(--font-sans,-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif);color:var(--accent,#007aff)}.ds-task:focus-visible{outline:3px solid var(--focus-ring,#7ab3ff);outline-offset:3px}"
    },
    {
      "name": "Agent 输入区",
      "kind": "custom",
      "refersTo": "prompt-input",
      "description": "轻面板输入区；输入聚焦时为整张面板提供明确反馈。",
      "html": "<div class=\"ds-prompt\"><textarea aria-label=\"向 Agent 提问\" placeholder=\"输入问题或探讨任务思路…\"></textarea></div>",
      "css": ".ds-prompt{box-sizing:border-box;width:min(100%,480px);background:var(--raised,#fff);border:1px solid var(--panel-border,#e8e8e6);border-radius:12px;box-shadow:var(--panel-shadow,0 1px 2px rgba(24,34,57,.05));padding:14px 14px 10px;transition:border-color .15s cubic-bezier(.3,1,.35,1),box-shadow .15s cubic-bezier(.3,1,.35,1)}.ds-prompt:focus-within{border-color:var(--accent,#007aff);box-shadow:var(--panel-shadow,0 1px 2px rgba(24,34,57,.05)),var(--focus-glow,0 0 0 3px rgba(0,122,255,.14))}.ds-prompt textarea{box-sizing:border-box;display:block;width:100%;resize:vertical;border:0;outline:none;background:transparent;font:15px/1.5 var(--font-sans,-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif);padding:4px 6px 0;color:var(--ink-soft,#42474d)}.ds-prompt textarea::placeholder{color:var(--faint,#9ca0a6)}"
    }
  ],
  "narrative": {
    "overview": "学习空间是「循阶」学生端界面的设计系统，覆盖首页、课程任务、Agent 对话页、任务工作区四个已确认页面。",
    "keyCharacteristics": [
      "中性基底 + 一个强调蓝：纯白画布、浅灰侧栏、hairline 描边，配 Apple 系统蓝；语义色只做小面积状态标记，成片着色不进入设计。",
      "文档化而非 App 化：标题用中文衬线、字号与字重收敛到 Apple 系统阶与 400/500/600 三档、控件去胶囊改圆角矩、阴影近零——与 Notion 一脉的基底同气质。",
      "背景安静、前景克制：动效四档时长 + 两条曲线，反馈幅度减半；仪器材质（虚拟开发板底座）与 IP 领地（动画形象）刻意排除在通用规则之外。"
    ],
    "rules": [],
    "dos": [
      "文本与背景的对比度按实际字号和字重判断：普通文字至少 4.5:1，大文字至少 3:1；大文字指至少 24px 常规字重或约 18.67px 粗体。14px 或 600 字重本身不能补偿对比不足。依据：[W3C Contrast Minimum](https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html)。",
      "状态用「亮底深字」并**同时**给文字标签，颜色只做辅助。",
      "嵌套圆角按「内层 = 外层 − 4px」取值，豁免四类（0 / 百分比 / ≥999px / ≥32px）跳过吸附。",
      "分层优先「hairline 描边 + 1px 微阴影」；浮层取三级递进中的一档，阴影色统一 `rgba(28,36,48,α)`。",
      "时长只用 150/240/350/500，缓动用 S 或 B；新的长动画（>900ms）与 0s 技巧先进豁免白名单再实现。",
      "字号只走 9 级阶梯、字重只用 400/500/600；正文与控件用系统栈，衬线只在 h1–h3。",
      "图表同色相时，用形状与位置区分「数据」与「可操作元素」。"
    ],
    "donts": [
      "不要把 `accent` 浅色主题下约 4.02:1 的白字组合用于普通大小文本；需要小字时使用经核对的深字浅底或 `primary` 近黑底。",
      "不要给 badge / tag / chip / pill / status 族加回 `999px`——它只留在豁免四类。",
      "不要把 50% 正圆头像 / 圆点当胶囊删掉，也不要把 `.ask` 开态 27px（= 半高）当「抖动值」吸附到 20px。",
      "不要把「现在 / 今天」重新染成暖色：`#ff8a3d` 系列已废，此刻固定 `data-now`。",
      "不要为「多色可辨」把构成图改成数据蓝：mosaic 与火焰是记录在案的有意例外（若日后改主意：mosaic 换 Apple 蓝四档，或火焰并入某档语义色）。",
      "不要把 `.db-card` / `.ws-dock` / `.mascot` 拉进 l2 面板族或 o2 浮层族——它们是平层、仪器材质与 IP 领地。",
      "不要引入橙 / 紫作为强调色，也不要把备用标签 hue 当强调色用（紫相「一眼 AI」）。",
      "不要把 A / B / C 三组（对话页 IP 出场、空状态档位、IP 点缀色）当已定 token：它们**明确移出设计系统范围**，属页面打磨阶段决策，届时落点是 [docs/agent-page-design.md](https://github.com/wubq511/XunJie_Design/blob/a9bb1dd016489d3e60e0b45933e440296c1194d8/docs/agent-page-design.md) 与页面对照。",
      "不要为了让「数据蓝 = 强调蓝」而让可操作元素只靠颜色标明（同色相是已知代价，靠形状 / 位置补偿）。",
      "不要在正文层引入 webfont，或把霞鹜文楷铺到正文与看板大数字上。"
    ]
  }
}
