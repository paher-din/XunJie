[Unit]
Description=Build and deploy the fixed XunJie main revision
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/lib/xunjie/sync-main.py --config /etc/xunjie/deployment.json
TimeoutStartSec=15min
Nice=10
MemoryMax=1600M
LimitCORE=0
UMask=0077
