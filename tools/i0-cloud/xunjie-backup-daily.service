[Unit]
Description=Daily encrypted backup of retained XunJie business data and recovery materials
After=xunjie-shared.service

[Service]
Type=oneshot
User=root
# The lock path must be <workDirectory>/deploy-artifact.lock from /etc/xunjie/deployment.json,
# so a backup never overlaps a release deployment (both hold the same flock).
ExecStart=/usr/bin/flock -w 2400 /var/lib/xunjie/work/deploy-artifact.lock /opt/xunjie/node/bin/node /opt/xunjie/current/tools/i0-cloud/backup-retained.mjs --config /etc/xunjie/backup.json --key-file /etc/xunjie/backup.key --label daily --keep 7
TimeoutStartSec=45min
CPUWeight=20
IOWeight=50
Nice=15
MemoryHigh=128M
MemoryMax=256M
LimitCORE=0
UMask=0077
