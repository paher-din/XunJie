[Unit]
Description=XunJie shared application and retained SQLite
After=network.target

[Service]
Type=simple
User=xunjie
Group=xunjie
WorkingDirectory=/opt/xunjie/current
Environment=NODE_ENV=production
Environment=TMPDIR=/var/lib/xunjie/retained-tmp
ExecStart=/opt/xunjie/node/bin/node --max-semi-space-size=16 /opt/xunjie/current/tools/i0-cloud/cloud-host.mjs --config /etc/xunjie/application-config.json --server-root /opt/xunjie/current/apps/server
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/xunjie
# #133 e03 five-member 905s run: ordinary API p95 262.266ms,
# candidate cgroup peak 329.152MiB including login; not formal idle usage.
# Formal budget headroom; the measured candidate retains its stricter 512M max.
CPUWeight=200
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
