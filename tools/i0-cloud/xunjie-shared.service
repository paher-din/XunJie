[Unit]
Description=XunJie shared application and retained SQLite
After=network.target

[Service]
Type=simple
User=xunjie
Group=xunjie
WorkingDirectory=/opt/xunjie/current
Environment=NODE_ENV=production
Environment=TMPDIR=/var/lib/xunjie/retained-tmp
ExecStart=/opt/xunjie/node/bin/node /opt/xunjie/current/tools/i0-cloud/cloud-host.mjs --config /etc/xunjie/application-config.json --teaching-root /opt/xunjie/current/apps/teaching
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/xunjie

[Install]
WantedBy=multi-user.target
# Candidate resource budgets; uncomment only after measuring real five-member
# traffic (watch `systemctl show xunjie-shared -p MemoryPeak` during a load run).
# Observed single-user cgroup peak: ~201 MiB (2026-10-23 server assessment).
#CPUWeight=200
#MemoryHigh=512M
#MemoryMax=768M
