server {
    listen 80;
    server_name __PUBLIC_IPV4__;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/xunjie-school-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://__PUBLIC_IPV4__$request_uri; }
}

server {
    listen 443 ssl;
    server_name __PUBLIC_IPV4__;
    ssl_certificate /etc/letsencrypt/live/__PUBLIC_IPV4__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IPV4__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:3444;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        send_timeout 300s;
    }
}
